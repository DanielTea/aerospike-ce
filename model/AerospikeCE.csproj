<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AerospikeCE</RootNamespace>
    <AssemblyName>AerospikeCE</AssemblyName>
  </PropertyGroup>

  <!--
    PicoGK is a real project reference, cloned into vendor/ (see README).
    ShapeKernel ships as source with no csproj, so it is compiled in directly.
    The Examples folder is deliberately excluded: it defines its own entry points.
  -->
  <ItemGroup>
    <ProjectReference Include="../vendor/PicoGK/PicoGK.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../vendor/LEAP71_ShapeKernel/ShapeKernel/**/*.cs" />
  </ItemGroup>

  <!--
    Copy the PicoGK native runtime next to the binary.

    The runtime ships inside the submodule already; there is nothing to install
    and no administrator rights involved. But PicoGK.csproj declares those
    libraries as <None Pack="true">, which packages them for NuGet consumers and
    does nothing at all for a project reference like ours. Without this the
    build succeeds, the app starts, and the P/Invoke fails at the first call
    into the kernel because the loader never sees picogk.

    Copied flat, because that is where the dynamic loader looks first.
  -->
  <ItemGroup Condition="'$([MSBuild]::IsOSPlatform(OSX))' == 'true'">
    <None Include="../vendor/PicoGK/native/osx-arm64/*.dylib">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$([MSBuild]::IsOSPlatform(Windows))' == 'true'">
    <None Include="../vendor/PicoGK/native/win-x64/*.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
